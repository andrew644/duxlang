package main

// The classic raylib starting screen, with no binding layer in between.
// `#[c_include]` reads raylib.h through libclang and `#[c_pkgconfig]`
// asks pkg-config what it takes to link. The colors are the raylib 5.5
// shapes — four `unsigned char`s, which is what `raylib.h` says today
// and what the importer read, not what a 2021 tutorial said. Records
// cross by value — `Color` in, `Vector2` back — through the wrappers
// the compiler writes and compiles with the header, which is why the
// call below that receives a `Vector2` from `GetMousePosition` is
// ordinary Dux.

#[c_include("raylib.h")]
#[c_pkgconfig("raylib")]
mod rl;

fn main() {
    rl.InitWindow(800, 450, c"dux on raylib")
    rl.SetTargetFPS(60)

    white := rl.Color { r: 245, g: 245, b: 245, a: 255 }
    maroon := rl.Color { r: 191, g: 26, b: 43, a: 255 }

        // `WindowShouldClose` answers in C's bool, which is its own type (D18);
    // `as bool` says the one thing that is true about it.
    while !(rl.WindowShouldClose() as bool) {
        mouse := rl.GetMousePosition()
        rl.BeginDrawing()
        rl.ClearBackground(white)
        rl.DrawText("move the mouse", 190, 200, 20, maroon)
        rl.DrawCircleV(mouse, 25.0, maroon)
        rl.EndDrawing()
    }

    rl.CloseWindow()
}
