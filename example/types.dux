package main

// Bindings, primitives, literals, and the implicit-conversion rule.

const KI: usize = 1024      // const  = compile-time value, no storage
static hits: i32 = 0        // static = one instance of storage, mutable

fn main() {
    count := 42             // :=   mutable,  inferred  (integer literals default to i32)
    let ratio = 0.75        // let  immutable, inferred (float literals default to f64)
    let mask: u64 = 0xff00  // let  immutable, explicit
    mut total: i64 = 0      // mut  mutable,  explicit

    count += 1
    hits += 1
    total = total + count   // i32 flows into i64 for free

    // Conversion rule: implicit exactly when the destination can hold every
    // value of the source. Lossless => free; anything else needs `as`.
    let small: u16 = 7
    let wider: i32 = small          // ok: u16 fits in i32
    let widest: i64 = wider         // ok: i32 fits in i64
    let narrow: i8 = widest as i8   // explicit: wraps in release, traps in debug
    let unsigned: u32 = wider as u32 // explicit: i32 may be negative
    let page: usize = KI + 1        // untyped constant adopts the target type

    // One value in, one value out. Multiple results travel as a tuple.
    let dims: [i32; 3] = [10, 20, 30]  // fixed array is a value type, `[T; N]`
    let pair: (i32, bool) = (1, true)  // tuple, so `-> (i32, bool)` is still one return

    total += wider + widest + narrow as i64 + unsigned as i64 + page as i64 + dims[0] as i64 + pair.0
    println($"count={count} ratio={ratio} mask={mask} total={total}")
    println($"narrow={} unsigned={} pair={}", narrow, unsigned, pair)
}
