package main

import "std/fs"

// These two are predeclared in universe scope -- ordinary enums, no magic:
//
//     enum Option<T> { Some(T), None }
//     enum Result<T, E> { Ok(T), Err(E) }

enum ParseError {
    NotANumber,
    OutOfRange,
}

// Errors are parameterised per function (no global error set), so a function
// that cannot fail does not lie about its return type.
fn parse_slot(s: string) -> Result<i32, ParseError> {
    value: i32 = 0
    for b in s.bytes() {
        if b < '0' || b > '9' {         // '0' is an untyped constant, adopts u8 here
            return Err(ParseError::NotANumber)
        }
        value = value * 10 + (b - '0') as i32
    }
    if value > 99 {
        return Err(ParseError::OutOfRange)
    }
    return Ok(value)
}

fn load_slot(path: string) -> Result<i32, string> {
    // Propagation is a match + return today: `?` / `or else` sugar is deferred
    // (README open item 5). `return` has type `never`, so it types as a match arm.
    text := match fs.read_to_string(path) {
        Ok(t)  => t,
        Err(e) => return Err($"cannot read {path}: {e}"),
    }
    return match parse_slot(text.trim()) {
        Ok(v)  => Ok(v),
        Err(e) => Err($"bad slot in {path}: {e}"),
    }
}

fn find(needle: string) -> Option<i32> {
    return if needle == "needle" { Some(7) } else { None }
}

fn main() {
    match load_slot("slot1.txt") {
        Ok(n)  => println($"slot = {n}"),
        Err(e) => println($"error: {e}"),
    }

    // Pattern conditions are the one piece of sugar we want early: match one
    // variant, bind its payload, fall through otherwise.
    if Ok(n) := parse_slot("42") {
        println($"parsed {n}")
    }

    opt := find("needle")
    println($"value={}", opt.unwrap_or(-1))
    match opt {
        Some(v) => println($"found {v}"),
        None    => println("nothing"),
    }

    // unwrap() panics on None: print + trap, no unwinding, defers do not run.
    println($"forced={}", opt.unwrap())

    _ := parse_slot("nope")          // ignoring a Result is a warning, so say so on purpose
}
