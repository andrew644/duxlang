package main

// These two are predeclared in universe scope -- ordinary enums, no magic:
//
//     enum Option<T> { Some(T), None }
//     enum Result<T, E> { Ok(T), Err(E) }

enum ParseError {
    NotANumber,
    OutOfRange,
}

// Errors are parameterised per function (no global error set), so a function
// that cannot fail does not lie about its return type.
fn parse_slot(s: string) -> Result<i32, ParseError> {
    value: i32 = 0
    for b in s.bytes() {
        if b < '0' || b > '9' {         // '0' is an untyped constant, adopts u8 here
            return Err(ParseError::NotANumber)
        }
        value = value * 10 + (b - '0') as i32
    }
    if value > 99 {
        return Err(ParseError::OutOfRange)
    }
    return Ok(value)
}

// Remapping one error type into another is a match today: `?` / `or else`
// sugar is a DESIGN open item. A `return` has type `never`, so it types as
// a match arm. (`load_slot` takes text already off the disk; reading files
// waits for a standard library.)
fn load_slot(text: string, source: string) -> Result<i32, string> {
    return match parse_slot(text) {
        Ok(v)                           => Ok(v),
        Err(ParseError::NotANumber)     => Err($"`{source}` holds no number"),
        Err(ParseError::OutOfRange)     => Err($"`{source}` is off the board"),
    }
}

fn find(needle: string) -> Option<i32> {
    return if needle == "needle" { Some(7) } else { None }
}

fn main() {
    match load_slot("42", "slot1") {
        Ok(n)  => println($"slot = {n}"),
        Err(e) => { println($"error: {e}"); del(e) },
    }
    match load_slot("one hundred", "slot2") {
        Ok(n)  => println($"slot = {n}"),
        Err(e) => { println($"error: {e}"); del(e) },
    }
    match load_slot("123", "slot3") {
        Ok(n)  => println($"slot = {n}"),
        Err(e) => { println($"error: {e}"); del(e) },
    }

    // Pattern conditions are the one piece of sugar we want early: match one
    // variant, bind its payload, fall through otherwise.
    if Ok(n) := parse_slot("42") {
        println($"parsed {n}")
    }

    opt := find("needle")
    missed := find("broom")

    // `unwrap_or` is a match by another name, and there is no method
    // syntax on a sum type yet -- the match is the language.
    println($"value={}", match opt { Some(v) => v, None => 0 - 1 })
    match missed {
        Some(v) => println($"found {v}"),
        None    => println("nothing found"),
    }
    println($"forced={}", match opt { Some(v) => v, None => 0 })

    _ := parse_slot("nope")            // ignoring a Result is a warning, so say so on purpose
}
