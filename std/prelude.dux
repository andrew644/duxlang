// The prelude: ordinary Dux, read into every program (DESIGN 3.1). `Option`
// and `Result` are the two predeclared enums; everything else the language
// uses through them is written here, in the language.

// `HashMap<K, V>` is the prelude's open-addressing table: three parallel
// views from the context — keys, values, and the `used` bits that say which
// slots hold a key — probed by the builtin `hash` and doubled when they fill
// past half.
struct HashMap<K, V> {
    keys: []K,
    values: []V,
    used: []bool,
    count: usize,
}

impl HashMap<K, V> {
    fn new() -> HashMap<K, V> {
        return HashMap<K, V> {
            keys: make(K, 16),
            values: make(V, 16),
            used: make(bool, 16),
            count: 0,
        }
    }

    fn len(self) -> usize {
        return self.count
    }

    fn is_empty(self) -> bool {
        return self.count == 0
    }

    fn get(self, key: K) -> Option<V> {
        at := self.probe(key)
        if self.used[at] {
            return Some(self.values[at])
        }
        return None
    }

    fn has(self, key: K) -> bool {
        return self.used[self.probe(key)]
    }

    fn insert(self: *HashMap<K, V>, key: K, value: V) {
        if (self.count + 1) * 2 > self.used.len() {
            self.rehash(self.used.len() * 2)
        }
        self.place(key, value)
    }

    fn clear(self: *HashMap<K, V>) {
        at: usize = 0
        while at < self.used.len() {
            self.used[at] = false
            at += 1
        }
        self.count = 0
    }

    fn destroy(self: *HashMap<K, V>) {
        del(self.keys)
        del(self.values)
        del(self.used)
        self.keys = self.keys[0..0]
        self.values = self.values[0..0]
        self.used = self.used[0..0]
        self.count = 0
    }

    // The slot where this key lives, or the first empty slot where it would
    // be placed. Probing stops at an empty slot because that is where the
    // key's own probe would have stopped too.
    fn probe(self, key: K) -> usize {
        span := self.used.len()
        at := hash(key) % span
        while self.used[at] && self.keys[at] != key {
            at = (at + 1) % span
        }
        return at
    }

    fn place(self: *HashMap<K, V>, key: K, value: V) {
        at := self.probe(key)
        if self.used[at] {
            self.values[at] = value
            return
        }
        self.used[at] = true
        self.keys[at] = key
        self.values[at] = value
        self.count += 1
    }

    // A fresh span, and every live key placed again into it: the old slots
    // are released once the new ones hold copies of them.
    fn rehash(self: *HashMap<K, V>, span: usize) {
        keys := self.keys
        values := self.values
        used := self.used
        self.keys = make(K, span)
        self.values = make(V, span)
        self.used = make(bool, span)
        self.count = 0
        at: usize = 0
        while at < used.len() {
            if used[at] {
                self.place(keys[at], values[at])
            }
            at += 1
        }
        del(keys)
        del(values)
        del(used)
    }
}

// `Vec<T>` is a growable array written against the context, as DESIGN D13
// asks: the storage comes from `make` and goes back with `del`, and nothing
// here is a builtin.
struct Vec<T> {
    items: []T,
    count: usize,
}

impl Vec<T> {
    fn new() -> Vec<T> {
        return Vec<T> { items: make(T, 8), count: 0 }
    }

    fn len(self) -> usize {
        return self.count
    }

    fn is_empty(self) -> bool {
        return self.count == 0
    }

    fn push(self: *Vec<T>, value: T) {
        if self.count >= self.items.len() {
            self.grow()
        }
        self.items[self.count] = value
        self.count += 1
    }

    fn get(self, at: usize) -> Option<T> {
        if at < self.count {
            return Some(self.items[at])
        }
        return None
    }

    fn pop(self: *Vec<T>) -> Option<T> {
        if self.count == 0 {
            return None
        }
        self.count -= 1
        return Some(self.items[self.count])
    }

    fn clear(self: *Vec<T>) {
        self.count = 0
    }

    // The view a `Vec` is holding: the filled prefix, no copy and no
    // allocation.
    fn slice(self) -> []T {
        return self.items[0..self.count]
    }

    // The storage is one block from the context; handing it back early is the
    // program saying it is done, and using the `Vec` after is the program's
    // mistake to make.
    fn destroy(self: *Vec<T>) {
        del(self.items)
        self.items = self.items[0..0]
        self.count = 0
    }

    fn grow(self: *Vec<T>) {
        room := self.items.len() * 2
        taller := make(T, room)
        at: usize = 0
        while at < self.count {
            taller[at] = self.items[at]
            at += 1
        }
        del(self.items)
        self.items = taller
    }
}

impl Option<T> {
    // `unwrap` stops the program when there is nothing to take, which waits on
    // the runtime that says why. `unwrap_or` can answer today.
    fn unwrap_or(self, fallback: T) -> T {
        match self {
            Some(v) => return v,
            None => return fallback,
        }
    }

    fn is_some(self) -> bool {
        match self {
            Some(_) => return true,
            None => return false,
        }
    }

    fn is_none(self) -> bool {
        match self {
            Some(_) => return false,
            None => return true,
        }
    }
}
