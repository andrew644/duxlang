package main

fn max(a: i32, b: i32) -> i32 {
    if a > b {
        return a
    }
    return b
}

fn main() {
    total := 0
    for i := 1, i <= 4, i += 1 {
        total += i
    }
    println($"total={total}")

    x := 0
    while x < 10 {
        x += 3
    }
    println($"x={x}")

    y := 0
    loop {
        y += 1
        if y == 2 {
            continue
        }
        if y >= 4 {
            break
        }
    }
    println($"x={x} y={y}")

    println($"{max(3, 9)} {max(9, 3)}")

    if total == 10 && max(1, 2) == 2 {
        println("both")
    }
    if total > 100 || x == 12 {
        println("either")
    }
    if !(total < 0) {
        println("not negative")
    }
}
