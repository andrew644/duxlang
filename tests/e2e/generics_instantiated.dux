package main

// Monomorphisation: a generic `fn` reaches machine code once per thing it was
// asked to be, and a generic `struct` once per way it was filled in.

fn max<T>(a: T, b: T) -> T {
    return if a > b { a } else { b }
}

fn fact<T>(n: T) -> T {
    return if n <= 1 { n } else { n * fact(n - 1) }
}

struct Pair<A, B> {
    first: A,
    second: B,
}

fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A> {
    return Pair<B, A> { first: p.second, second: p.first }
}

// A `const` parameter is a compile-time value, which is how a generic gets to
// name an array size.
fn tally<const N: usize>(step: i32) -> i32 {
    grid := [step; N]
    total: i32 = 0
    for v in grid {
        total += v
    }
    return total
}

// A `const` parameter answers an array size, and the array answers back from
// the call whole.
fn zeros<const N: usize>() -> [i32; N] {
    return [0; N]
}

fn total(xs: []i32) -> i32 {
    sum: i32 = 0
    for v in xs {
        sum += v
    }
    return sum
}

struct Cell<T> {
    value: T,
    next: Option<*Cell<T>>,
}

fn head<T>(c: Cell<T>) -> T {
    return c.value
}

// A method of a generic `impl` is code the receiver completes: the `impl`
// carries the parameters, and each receiver that calls for it says them.
impl Cell<T> {
    fn value(self: Cell<T>) -> T {
        return self.value
    }

    fn hops(self: Cell<T>) -> i32 {
        count: i32 = 1
        cursor: Option<*Cell<T>> = self.next
        while Some(cell) := cursor {
            count += 1
            cursor = cell.next
        }
        return count
    }
}

impl Pair<A, B> {
    fn only(self: Pair<A, B>) -> A {
        return self.first
    }
}

fn main() {
    println($"max={} {} {}", max(3, 7), max(2.5, 1.5), max<i64>(9, 4))
    println($"fact={}", fact<i64>(5))

    p := Pair<i32, string> { first: 1, second: "one" }
    q := swap(p)
    println($"pair={} {} swapped={} {}", p.first, p.second, q.first, q.second)
    println($"tally={} {}", tally<3>(7), tally<5>(2))

    n := Cell<i32> { value: 9, next: None }
    tail := Cell<string> { value: "last", next: None }
    mid := Cell<string> { value: "mid", next: Some(&tail) }
    top := Cell<string> { value: "top", next: Some(&mid) }
    println($"head={}", head(top))
    println($"cell={} {}", n.value(), n.hops())
    println($"top={} hops={}", top.value(), top.hops())
    println($"only={}", p.only())
    cursor: Option<*Cell<string>> = Some(&top)
    hops: i32 = 0
    while Some(cell) := cursor {
        hops += 1
        cursor = cell.next
    }
    println($"hops={}", hops)
    grid := zeros<4>()
    println($"grid={} view={}", grid[2], total(&[1, 2, 3]))
}
