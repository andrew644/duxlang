package main

enum Shape {
    Circle(f32),
    Rect { w: f32, h: f32 },
    Point,
}

fn area(s: Shape) -> f32 {
    return match s {
        Shape::Circle(r) => 3.0 * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Point => 0.0,
    }
}

fn name(s: Shape) -> string {
    return match s {
        Shape::Circle(_) => "circle",
        Shape::Rect { .. } => "rect",
        Shape::Point => "point",
    }
}

fn tally(n: i32) -> string {
    return match n {
        0 => "none",
        1 | 2 | 3 => "few",
        4..=9 => "some",
        x if x < 0 => $"negative {x}",
        _ => "many",
    }
}

fn code(s: string) -> i32 {
    return match s {
        "read" => 1,
        "write" | "append" => 2,
        _ => 0,
    }
}

fn note(n: i32) {
    match n {
        0 => println("noted zero"),
        else => println("noted something")
    }
}

fn main() {
    shapes := [Shape::Circle(2.0), Shape::Rect { w: 3.0, h: 4.0 }, Shape::Point]
    for s in shapes {
        println($"{} area={}", name(s), area(s))
    }
    for n in [0, 2, 7, -1, 50] {
        println($"{tally(n)}")
    }
    one := code("read")
    two := code("append")
    zero := code("other")
    println($"{} {} {}", one, two, zero)
    note(0)
    note(5)
    values := [7, 8, 9]
    picked := match values {
        ys => ys[0] + ys[2],
    }
    println($"{picked}")
}
