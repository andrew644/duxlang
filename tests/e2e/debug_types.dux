package main

struct Vec3 {
    x: i32,
    y: i32,
    z: i32,
}

enum Event {
    Nothing,
    Tick(i64),
}

fn scaled(v: Vec3, k: i32) -> Vec3 {
    return Vec3 { x: v.x * k, y: v.y * k, z: v.z * k }
}

fn main() {
    start := Vec3 { x: 1, y: 2, z: 3 }
    big := scaled(start, 2)
    cells := [4, 5, 6]
    view := cells[0..2]
    event := Event::Tick(9)
    println($"{} {} {} {}", big.x, big.z, view[1], match event { Event::Nothing => 0, Event::Tick(n) => n } as i32)
}
